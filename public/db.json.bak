                    {
                      "questionId": "sci-q2",
                      "questionText": "நடக்கப் பயன்படும் உடல் உறுப்பு எது? (Which body part is used for walking?)",
                      "options": ["கை (Hand)", "கால் (Leg)", "தலை (Head)"],
                      "correctAnswer": "கால் (Leg)"
                    }
                  ]

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email.lower() == 'kontaktaone@gmail.com'
      );
    }

    // 1. User records and their subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow list: if isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, list: if isAdmin();
      }
    }
    
    // 2. Teachers Collection
    match /teachers/{teacherId} {
      allow read: if request.auth != null && 
                  (request.auth.token.email.lower() == teacherId.lower() || isAdmin());
      
      allow create: if request.auth != null;
      allow update, delete, list: if isAdmin();
    }

    // 3. Child Username Registry
    match /child_usernames/{username} {
      allow read: if true; 
      allow write: if request.auth != null; 
    }

    // 4. Educational Content (Subjects, Levels, Lessons)
    match /learning_content/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /subjects/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /lessons/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 5. Global Student Search (Collection Group)
    match /{path=**}/children/{childId} {
      allow read, list: if isAdmin();
    }

    // Default: restricted
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'kontaktaone@gmail.com' ||
          request.auth.token.email.lower() == 'teacher_test@example.com'
        ))
      );
    }

    // Helper function for active teacher check
    function isActiveTeacher() {
      const email = request.auth != null && request.auth.token.email != null 
                    ? request.auth.token.email.lower() 
                    : null;
      return email != null &&
        exists(/databases/$(database)/documents/teachers/$(email)) &&
        get(/databases/$(database)/documents/teachers/$(email)).data.status == 'active';
    }

    // 1. User records and their subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow list: if isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, list: if isAdmin();
      }
    }
    
    // 2. Teachers Collection
    match /teachers/{teacherId} {
      allow read: if request.auth != null && 
                  (request.auth.token.email.lower() == teacherId.lower() || isAdmin());
      
      allow create: if request.auth != null;
      allow update, delete, list: if isAdmin();
    }

    // 3. Child Username Registry
    match /child_usernames/{username} {
      allow read: if true; 
      allow write: if request.auth != null; 
    }

    // 4. Educational Content (Subjects, Levels, Lessons)
    // Publicly readable, restricted write
    match /learning_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isActiveTeacher();
    }

    match /subjects/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isActiveTeacher();
    }
    
    match /levels/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isActiveTeacher();
    }

    match /achievements/{document=**} {
      allow read, write: if true;
    }

    match /childStats/{document=**} {
      allow read, write: if true;
    }
    
    match /lessons/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isActiveTeacher();
    }

    // 5. Global Student Search (Collection Group)
    match /{path=**}/children/{childId} {
      allow read, list: if isAdmin();
    }

    // 6. Global Task History (Collection Group for Reports)
    match /{path=**}/taskHistory/{historyId} {
      allow read, list: if true;
      allow write: if request.auth != null || true;
    }

    // 7. Support Tickets
    match /tickets/{document=**} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // Default: restricted
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'kontaktaone@gmail.com' ||
          request.auth.token.email.lower() == 'teacher_test@example.com'
        ))
      );
    }

    // Helper function for active teacher check
    function isActiveTeacher() {
      let email = request.auth != null && request.auth.token.email != null
                    ? request.auth.token.email.lower()
                    : null;
      return email != null &&
        exists(/databases/$(database)/documents/teachers/$(email)) &&
        get(/databases/$(database)/documents/teachers/$(email)).data.status == 'active';
    }

    // 1. User records and their subcollections
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow list: if isAdmin();

      // Account creation (signup) may only set the initial free-trial state —
      // never a paid plan or any billing fields, which are written exclusively
      // by the Stripe webhook / API routes via the Admin SDK (which bypasses
      // these rules entirely, so this never blocks a real payment).
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('planType' in request.resource.data) || request.resource.data.planType == 'free_trial')
        && !('subscriptionStatus' in request.resource.data)
        && !('subscriptionPlan' in request.resource.data)
        && !('subscriptionExpiresAt' in request.resource.data)
        && !('lastPayment' in request.resource.data);

      // Profile edits may not touch billing/subscription fields — those are
      // server-authoritative (Stripe webhook via Admin SDK). Without this, any
      // signed-in user could grant themselves Premium for free by writing
      // straight to their own document.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['subscriptionStatus', 'subscriptionPlan', 'subscriptionExpiresAt', 'lastPayment'])
        && (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['planType', 'subscription'])
             || (request.resource.data.planType == 'free_trial'
                 && request.resource.data.subscription.plan == 'trial'
                 && request.resource.data.subscription.status == 'active')
           );

      allow delete: if false;

      // Children profiles — fully owned by the parent.
      match /children/{childId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, list: if isAdmin();
      }

      // Invoice/payment history — server-written only (Stripe webhook via
      // Admin SDK); the parent may read their own but never write or delete it.
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
        allow read, list: if isAdmin();
      }
    }
    
    // 2. Teachers Collection
    match /teachers/{teacherId} {
      allow read: if request.auth != null && 
                  (request.auth.token.email.lower() == teacherId.lower() || isAdmin());
      
      allow create: if request.auth != null;
      allow update, delete, list: if isAdmin();
    }

    // 3. Child Username Registry
    match /child_usernames/{username} {
      allow read: if true; 
      allow write: if request.auth != null; 
    }

    // 4. Educational Content (Subjects, Levels, Lessons)
    // Publicly readable, restricted write
    match /learning_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isActiveTeacher();
    }

    match /subjects/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isActiveTeacher();
    }
    
    match /levels/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isActiveTeacher();
    }

    match /achievements/{document=**} {
      allow read, write: if true;
    }

    match /childStats/{document=**} {
      allow read, write: if true;
    }
    
    match /lessons/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isActiveTeacher();
    }

    // 5. Global Student Search (Collection Group)
    match /{path=**}/children/{childId} {
      allow read, list: if isAdmin();
    }

    // 6. Global Task History (Collection Group for Reports)
    match /{path=**}/taskHistory/{historyId} {
      allow read, list: if true;
      allow write: if request.auth != null || true;
    }

    // 7. Support Tickets
    match /tickets/{document=**} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // Default: restricted
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

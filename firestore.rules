rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── 1. STUDENT LOGIN FLOW (PUBLIC ACCESS) ────────────────────────
    // These must be accessible without Firebase Auth for student login.
    
    match /child_usernames/{username} {
      allow get: if true;
      // Writing usernames requires parent auth
      allow write, delete: if request.auth != null && (request.resource.data.parentUid == request.auth.uid || resource.data.parentUid == request.auth.uid);
    }
    
    match /users/{userId} {
      // Required for subscription status check in ChildProvider & login checks
      allow get: if true;
      
      match /children/{childId} {
        // Required to fetch child profile for PIN verification & progress loading
        allow get: if true;
        
        // Subcollections like stats, achievements, etc. 
        // We open these for the child session to save progress.
        match /{allChildrenSubcollections=**} {
           allow read, write: if true; 
        }
      }
    }

    // ── 2. PARENT & TEACHER SECURE ACCESS ────────────────────────────
    // Locked down by Firebase Auth ID (UID)
    
    match /users/{userId}/{documents=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email)) ||
        request.auth.token.email == "kontaktaone@gmail.com"
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ── 3. OTHER COLLECTIONS ──────────────────────────────────────────
    
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /teachers/{teacherEmail} {
      allow get: if request.auth != null && request.auth.token.email == teacherEmail;
      allow read, write: if request.auth != null && request.auth.token.email == "kontaktaone@gmail.com";
    }

    match /levels/{levelId} {
      allow read: if true;
      allow write: if request.auth != null && (
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email)) ||
        request.auth.token.email == "kontaktaone@gmail.com"
      );
    }
  }
}